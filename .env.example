# BILI Store environment template
# Copy the values that apply to your host into the host's secret manager or local .env file.

# Frontend
VITE_API_BASE_URL=http://localhost:5087/api

# Backend hosting
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5087

# Backend database
# ASP.NET Core uses double underscores for nested configuration keys.
ConnectionStrings__BiliStoreDb=Server=(localdb)\\mssqllocaldb;Database=BiliStoreDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# Backend CORS
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=https://localhost:5173

# Backend authentication
Jwt__Issuer=BiliStore.Api
Jwt__Audience=BiliStore.Frontend
Jwt__SigningKey=replace-with-a-secure-development-secret-at-least-32-characters

# Payments
# Keep Development until a real provider has been selected and configured securely.
Payments__Provider=Development
Payments__PayFast__MerchantId=
Payments__PayFast__MerchantKey=
Payments__PayFast__Passphrase=
Payments__PeachPayments__EntityId=
Payments__PeachPayments__AccessToken=
Payments__Yoco__SecretKey=
