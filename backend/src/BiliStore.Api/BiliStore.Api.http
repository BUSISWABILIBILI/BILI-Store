POST {{BiliStore.Api_HostAddress}}/api/admin/products
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Demo Custom Dress",
  "slug": "demo-custom-dress",
  "description": "Admin-created custom dress for testing catalogue management.",
  "price": 1499,
  "clothingType": "Dress",
  "estimatedProductionDays": 14,
  "isAvailable": true,
  "isFeatured": false,
  "allowsCustomColor": true,
  "fabricDescription": "Cotton blend with decorative trim.",
  "primaryImageUrl": "/images/bili-atelier-hero.png",
  "primaryImageAltText": "Demo custom dress",
  "categoryIds": ["{{CategoryId}}"],
  "colourIds": ["{{ColourId}}"],
  "measurementRequirements": [
    {
      "measurementTypeId": "{{MeasurementTypeId}}",
      "isRequired": true,
      "minValueCm": 60,
      "maxValueCm": 140,
      "helpText": "Measure while standing straight."
    }
  ]
}

###

