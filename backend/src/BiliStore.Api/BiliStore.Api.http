@BiliStore.Api_HostAddress = http://localhost:5087

GET {{BiliStore.Api_HostAddress}}/api/health
Accept: application/json

###

GET {{BiliStore.Api_HostAddress}}/api/system
Accept: application/json

###

GET {{BiliStore.Api_HostAddress}}/api/products
Accept: application/json

###

GET {{BiliStore.Api_HostAddress}}/api/products?category=women&featured=true
Accept: application/json

###

GET {{BiliStore.Api_HostAddress}}/api/products/burgundy-imvunulo-dress
Accept: application/json

###

GET {{BiliStore.Api_HostAddress}}/api/categories
Accept: application/json

###

GET {{BiliStore.Api_HostAddress}}/api/colours
Accept: application/json

###

GET {{BiliStore.Api_HostAddress}}/api/measurements
Accept: application/json

###

POST {{BiliStore.Api_HostAddress}}/api/measurements/validate
Content-Type: application/json

{
  "productSlug": "burgundy-imvunulo-dress",
  "measurements": [
    { "measurementKey": "bust_chest", "valueCm": 94 },
    { "measurementKey": "waist", "valueCm": 76 },
    { "measurementKey": "hips", "valueCm": 104 },
    { "measurementKey": "shoulder_width", "valueCm": 40 },
    { "measurementKey": "dress_length", "valueCm": 145 }
  ]
}

###

POST {{BiliStore.Api_HostAddress}}/api/cart/quote
Content-Type: application/json

{
  "items": [
    {
      "productSlug": "burgundy-imvunulo-dress",
      "selectedColourId": "20000000-0000-0000-0000-000000000007",
      "customColourName": null,
      "customColourHex": null,
      "quantity": 1,
      "measurements": [
        { "measurementKey": "bust_chest", "measurementName": "Bust/Chest", "valueCm": 94, "unit": "cm" },
        { "measurementKey": "waist", "measurementName": "Waist", "valueCm": 76, "unit": "cm" },
        { "measurementKey": "hips", "measurementName": "Hips", "valueCm": 104, "unit": "cm" },
        { "measurementKey": "shoulder_width", "measurementName": "Shoulder width", "valueCm": 40, "unit": "cm" },
        { "measurementKey": "dress_length", "measurementName": "Dress length", "valueCm": 145, "unit": "cm" }
      ]
    }
  ]
}

###

POST {{BiliStore.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Demo",
  "lastName": "Customer",
  "email": "demo.customer@example.com",
  "phone": "0821234567",
  "password": "Password1",
  "confirmPassword": "Password1"
}

###

POST {{BiliStore.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "demo.customer@example.com",
  "password": "Password1"
}

###

GET {{BiliStore.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PUT {{BiliStore.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Demo",
  "lastName": "Customer",
  "phone": "0821234567"
}

###

POST {{BiliStore.Api_HostAddress}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "demo.customer@example.com"
}

###

POST {{BiliStore.Api_HostAddress}}/api/customers/me/measurement-profiles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "My Measurements",
  "isDefault": true,
  "notes": "Saved from product detail measurement form.",
  "measurements": [
    { "measurementKey": "bust_chest", "valueCm": 94 },
    { "measurementKey": "waist", "valueCm": 76 },
    { "measurementKey": "hips", "valueCm": 104 }
  ]
}

###

GET {{BiliStore.Api_HostAddress}}/api/customers/me/orders
Authorization: Bearer {{accessToken}}
Accept: application/json

###
