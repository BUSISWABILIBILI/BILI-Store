  "name": "Updated Custom Dress",
  "slug": "updated-custom-dress",
  "description": "Updated product details from the admin catalogue endpoint.",
  "price": 1699,
  "clothingType": "Dress",
  "estimatedProductionDays": 16,
  "isAvailable": true,
  "isFeatured": true,
  "allowsCustomColor": true,
  "fabricDescription": "Premium cotton blend with custom trim.",
