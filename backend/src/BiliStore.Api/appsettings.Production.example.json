{
  "ConnectionStrings": {
    "BiliStoreDb": "Server=tcp:your-sql-server.database.windows.net,1433;Initial Catalog=BiliStoreDb;Persist Security Info=False;User ID=your-db-user;Password=your-db-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-bili-store-domain.co.za"
    ]
  },
  "Jwt": {
    "Issuer": "BiliStore.Api",
    "Audience": "BiliStore.Frontend",
    "SigningKey": "replace-with-a-secure-production-secret-at-least-32-characters"
  },
  "Payments": {
    "Provider": "Development",
    "PayFast": {
      "MerchantId": "",
      "MerchantKey": "",
      "Passphrase": ""
    },
    "PeachPayments": {
      "EntityId": "",
      "AccessToken": ""
    },
    "Yoco": {
      "SecretKey": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
